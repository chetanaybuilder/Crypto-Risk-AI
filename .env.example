# ==============================================================================
# CryptoRisk AI - Environment Configuration Template
# Copy this file to .env and populate with your production or local secrets.
# ==============================================================================

# Flask Environment ("development" or "production")
FLASK_ENV=development
SECRET_KEY=your_secure_random_secret_key_here

# PostgreSQL Database Connection URL (e.g. Supabase, Neon, or local Postgres)
# If empty, application runs in stateless demo mode without persistent history.
DATABASE_URL=postgresql://user:password@localhost:5432/cryptorisk

# Google Gemini AI API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=60000
GEMINI_MAX_RETRIES=2
GEMINI_WORKERS=2

# Authentication & JWT Configuration
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ACCESS_TOKEN_EXPIRES_DAYS=7

# Google OAuth (Optional - required only for Google Sign-In)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# CoinGecko API Configuration
# Plan: "demo" (free key) or "pro" (paid tier)
COINGECKO_PLAN=demo
COINGECKO_API_KEY=your_coingecko_api_key_here
COINGECKO_MAX_RETRIES=3

# Optional Fallback Market Data Providers
ENABLE_BINANCE_FALLBACK=false
CMC_API_KEY=
CMC_API_URL=https://pro-api.coinmarketcap.com/v1

# Cache & Performance Tuning (seconds)
MARKET_TIMEOUT=12
HISTORY_CACHE_TTL=60
MARKET_CACHE_TTL=90
MARKET_STALE_MAX_AGE=1800
HISTORY_STALE_MAX_AGE=86400
MARKET_CAP_CACHE_TTL=900
COIN_RESOLUTION_CACHE_TTL=86400

# Worker & Pool Settings
ANALYSIS_WORKERS=5
ANALYSIS_JOB_TIMEOUT_SECONDS=150
JOB_TTL_SECONDS=1800
DB_POOL_MIN_CONN=2
DB_POOL_MAX_CONN=20
