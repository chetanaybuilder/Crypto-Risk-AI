# Copy this file to `.env` and fill in real values. Do NOT commit your `.env` file to Git.

SECRET_KEY=your_secret_key
GEMINI_API_KEY=your_gemini_api_key
# Example DATABASE_URL formats:
# PostgreSQL (Render / Heroku style): postgresql://username:password@host:port/database
# Render Postgres managed service will provide a DATABASE_URL automatically.
DATABASE_URL=postgresql://username:password@host:port/database
